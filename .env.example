# FactLens Configuration Environment Variables

# LLM Configuration
# Optional: Set Gemini API key for LLM-powered extraction and reasoning.
# If omitted or empty, FactLens runs in high-performance offline deterministic mode.
GEMINI_API_KEY=

# Server Configuration
FACTLENS_HOST=0.0.0.0
FACTLENS_PORT=8000
FACTLENS_DEBUG=true

# Storage & Database
FACTLENS_DB_PATH=data/factlens.db
UPLOAD_DIR=data/uploads

# Security Limits
MAX_FILE_SIZE_MB=50
MAX_PAGE_COUNT=120
ALLOWED_EXTENSIONS=pdf

# Protected API Secret (Optional basic bearer auth for write APIs if desired)
API_SECRET_KEY=

# Redis & Caching Configuration
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_ENABLED=true
CACHE_TTL_DEFAULT=3600
CACHE_TTL_FACTS=86400

# Malware Scanning (ClamAV) Configuration
# Modes: dev_mock (development-safe mock), clamav (real daemon), fail_closed (reject if clamav unreachable)
MALWARE_SCAN_MODE=dev_mock
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
CLAMAV_TIMEOUT_SECONDS=10

# Background Processing & Job Queue
QUEUE_MODE=redis
QUEUE_MAX_RETRIES=3
JOB_TIMEOUT_SECONDS=120

